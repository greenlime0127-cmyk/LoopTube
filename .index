<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>유튜브 무한반복 루퍼 (YouTube Looper)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Phosphor Icons CDN -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- Google Fonts: Inter & Noto Sans KR -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', 'Noto Sans KR', sans-serif;
            background-color: #0d0f17;
            color: #f3f4f6;
        }
        /* Glassmorphism Styles */
        .glass-panel {
            background: rgba(22, 27, 46, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }
        .glass-input {
            background: rgba(13, 15, 23, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.25s ease;
        }
        .glass-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
            outline: none;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(13, 15, 23, 0.5);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        /* Neon Glow Effects */
        .neon-glow {
            box-shadow: 0 0 20px rgba(99, 102, 241, 0.4);
        }
        .neon-glow:hover {
            box-shadow: 0 0 28px rgba(99, 102, 241, 0.6);
        }
        .pulse-red {
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">

    <!-- Header -->
    <header class="glass-panel sticky top-0 z-50 px-4 lg:px-8 py-4 mb-6">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3 cursor-pointer" onclick="window.scrollTo({top:0, behavior:'smooth'})">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 flex items-center justify-center shadow-lg">
                    <i class="ph-bold ph-repeat text-2xl text-white"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-transparent">
                        LoopTube
                    </h1>
                    <p class="text-xs text-slate-400">유튜브 무한반복 재생기</p>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs font-medium text-slate-400">
                <span class="px-3 py-1 rounded-full bg-slate-800/80 border border-slate-700/50 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Auto Loop Active
                </span>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 lg:px-8 w-full flex-grow flex flex-col gap-6 mb-12">
        
        <!-- Input Section -->
        <section class="glass-panel rounded-2xl p-4 sm:p-6 transition-all duration-300">
            <form id="urlForm" onsubmit="handleUrlSubmit(event)" class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-grow">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="ph-bold ph-link text-xl"></i>
                    </div>
                    <input 
                        type="text" 
                        id="youtubeUrl" 
                        placeholder="유튜브 동영상 링크(URL)를 입력하세요... (예: https://www.youtube.com/watch?v=...)" 
                        class="glass-input w-full pl-11 pr-10 py-3.5 rounded-xl text-sm text-slate-100 placeholder-slate-500 font-normal focus:outline-none"
                        required
                    />
                    <button 
                        type="button" 
                        onclick="clearInput()" 
                        id="clearBtn"
                        class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-white transition-colors"
                    >
                        <i class="ph-bold ph-x-circle text-lg"></i>
                    </button>
                </div>
                <button 
                    type="submit" 
                    class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-6 py-3.5 rounded-xl text-sm transition-all duration-300 flex items-center justify-center gap-2 neon-glow whitespace-nowrap active:scale-95"
                >
                    <i class="ph-bold ph-play text-lg"></i>
                    반복 재생 시작
                </button>
            </form>
            <p id="errorMessage" class="text-xs text-rose-400 mt-2 hidden flex items-center gap-1">
                <i class="ph-bold ph-warning-circle"></i> 올바른 유튜브 동영상 URL 또는 비디오 ID를 입력해주세요.
            </p>
        </section>

        <!-- Player & Controls Grid Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Left Side: Player Container (2 Cols on lg) -->
            <div class="lg:col-span-2 flex flex-col gap-4">
                <div class="glass-panel rounded-2xl overflow-hidden p-2 sm:p-3 relative group">
                    <!-- Responsive Video Wrapper (16:9) -->
                    <div class="relative w-full pb-[56.25%] rounded-xl overflow-hidden bg-slate-950 shadow-inner">
                        <!-- Placeholder before loading video -->
                        <div id="playerPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center text-slate-500 z-10 bg-slate-900/90 backdrop-blur-md">
                            <i class="ph-duotone ph-youtube-logo text-6xl text-rose-500 mb-3 animate-pulse"></i>
                            <h3 class="text-base font-semibold text-slate-300 mb-1">재생할 영상이 없습니다</h3>
                            <p class="text-xs max-w-md text-slate-400">상단에 유튜브 링크를 입력하고 '반복 재생 시작'을 누르면 이곳에서 무한 반복 영상이 시작됩니다.</p>
                        </div>
                        <!-- YouTube Player Embed Container -->
                        <div id="player" class="absolute top-0 left-0 w-full h-full"></div>
                    </div>
                </div>

                <!-- Playback Controller Panel -->
                <div class="glass-panel rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4">
                    <!-- Left: Play/Pause/Stop Buttons -->
                    <div class="flex items-center gap-2">
                        <button id="playPauseBtn" onclick="togglePlayPause()" class="w-11 h-11 rounded-xl bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all border border-slate-700/50 hover:border-slate-600 disabled:opacity-50" disabled>
                            <i class="ph-bold ph-play text-xl" id="playIcon"></i>
                        </button>
                        <button id="stopBtn" onclick="stopVideo()" class="w-11 h-11 rounded-xl bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all border border-slate-700/50 hover:border-slate-600 disabled:opacity-50" disabled>
                            <i class="ph-bold ph-square text-lg"></i>
                        </button>
                        <button id="restartBtn" onclick="restartVideo()" class="w-11 h-11 rounded-xl bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all border border-slate-700/50 hover:border-slate-600 disabled:opacity-50" title="처음부터 재생" disabled>
                            <i class="ph-bold ph-arrows-counter-clockwise text-xl"></i>
                        </button>
                    </div>

                    <!-- Center: Status Info -->
                    <div class="flex items-center gap-3">
                        <span id="currentTimeDisplay" class="font-mono text-sm font-semibold text-indigo-400 bg-indigo-950/50 border border-indigo-800/40 px-3 py-1.5 rounded-lg">00:00 / 00:00</span>
                    </div>

                    <!-- Right: Toggles (Loop, Mute, Speed) -->
                    <div class="flex items-center gap-2">
                        <!-- Mute Toggle -->
                        <button id="muteBtn" onclick="toggleMute()" class="w-11 h-11 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-all border border-slate-700/50 disabled:opacity-50" disabled>
                            <i class="ph-bold ph-speaker-high text-xl" id="muteIcon"></i>
                        </button>
                        <!-- Loop Toggle -->
                        <button id="loopToggleBtn" onclick="toggleLoop()" class="px-3.5 h-11 rounded-xl bg-indigo-600/20 text-indigo-300 border border-indigo-500/40 hover:bg-indigo-600/30 font-medium text-xs flex items-center gap-2 transition-all">
                            <i class="ph-bold ph-repeat text-base"></i>
                            <span id="loopStatusText">무한반복 ON</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Side: A-B Repeat Loop Settings & History (1 Col) -->
            <div class="flex flex-col gap-6">
                
                <!-- A-B Repeat Loop Settings Card -->
                <div class="glass-panel rounded-2xl p-5 flex flex-col gap-4">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <div class="flex items-center gap-2">
                            <i class="ph-bold ph-scissors text-indigo-400 text-lg"></i>
                            <h2 class="font-semibold text-sm text-slate-200">A-B 구간 무한 반복</h2>
                        </div>
                        <!-- Toggle Switch for Section Loop -->
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="abLoopToggle" onchange="toggleABLoop()" class="sr-only peer">
                            <div class="w-9 h-5 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600"></div>
                        </label>
                    </div>

                    <!-- Time Input Fields -->
                    <div class="grid grid-cols-2 gap-3">
                        <!-- Start Time (A) -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-slate-400 font-medium flex justify-between">
                                <span>시작 시간 (A)</span>
                                <button type="button" onclick="setABCurrent('start')" class="text-[10px] text-indigo-400 hover:underline">현재시간 설정</button>
                            </label>
                            <input 
                                type="text" 
                                id="startTime" 
                                placeholder="00:00" 
                                value="00:00"
                                onchange="validateAndSaveAB()"
                                class="glass-input text-center py-2 px-3 rounded-lg text-sm font-mono text-slate-100"
                            />
                        </div>

                        <!-- End Time (B) -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-slate-400 font-medium flex justify-between">
                                <span>종료 시간 (B)</span>
                                <button type="button" onclick="setABCurrent('end')" class="text-[10px] text-indigo-400 hover:underline">현재시간 설정</button>
                            </label>
                            <input 
                                type="text" 
                                id="endTime" 
                                placeholder="00:00" 
                                value="00:00"
                                onchange="validateAndSaveAB()"
                                class="glass-input text-center py-2 px-3 rounded-lg text-sm font-mono text-slate-100"
                            />
                        </div>
                    </div>

                    <div class="text-[11px] text-slate-400 bg-slate-900/50 p-2.5 rounded-lg border border-slate-800/80 leading-relaxed">
                        💡 시간 입력 형식: <code class="text-indigo-300">초(예: 90)</code> 또는 <code class="text-indigo-300">분:초(예: 1:30)</code> 또는 <code class="text-indigo-300">시:분:초(1:05:20)</code>
                    </div>
                </div>

                <!-- Recent Playback History -->
                <div class="glass-panel rounded-2xl p-5 flex flex-col gap-3 flex-grow max-h-[380px]">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <div class="flex items-center gap-2">
                            <i class="ph-bold ph-clock-counter-clockwise text-indigo-400 text-lg"></i>
                            <h2 class="font-semibold text-sm text-slate-200">최근 재생 목록</h2>
                        </div>
                        <button onclick="clearHistory()" class="text-xs text-slate-400 hover:text-rose-400 transition-colors flex items-center gap-1">
                            <i class="ph-bold ph-trash"></i> 전체 삭제
                        </button>
                    </div>

                    <!-- History List Item Container -->
                    <div id="historyList" class="flex flex-col gap-2 overflow-y-auto pr-1 flex-grow">
                        <!-- Dynamic items will be inserted here -->
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="glass-panel py-4 px-6 text-center text-xs text-slate-500 mt-auto">
        <p>© 2026 LoopTube. YouTube IFrame API를 기반으로 안전하게 작동하는 무한반복 서비스입니다.</p>
    </footer>

    <script>
        // --- Global Variables ---
        let player = null;
        let isPlayerReady = false;
        let checkLoopInterval = null;
        let isLoopEnabled = true;
        let isABLoopEnabled = false;
        let abStartTime = 0;
        let abEndTime = 0;
        let currentVideoId = '';

        // --- YouTube IFrame API Load ---
        const tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        const firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

        function onYouTubeIframeAPIReady() {
            // API Ready - waiting for video load call
            loadHistoryUI();
        }

        // --- Video Player Initialization ---
        function createPlayer(videoId) {
            currentVideoId = videoId;
            
            // Hide placeholder
            document.getElementById('playerPlaceholder').classList.add('hidden');

            if (player) {
                player.loadVideoById({
                    videoId: videoId,
                    startSeconds: isABLoopEnabled ? abStartTime : 0
                });
                return;
            }

            player = new YT.Player('player', {
                height: '100%',
                width: '100%',
                videoId: videoId,
                playerVars: {
                    'autoplay': 1,
                    'controls': 1,
                    'rel': 0,
                    'modestbranding': 1,
                    'playsinline': 1
                },
                events: {
                    'onReady': onPlayerReady,
                    'onStateChange': onPlayerStateChange
                }
            });
        }

        function onPlayerReady(event) {
            isPlayerReady = true;
            enableControls(true);
            event.target.playVideo();
            startLoopChecker();
            
            // Save video metadata to history once video details are fetched
            saveToHistory(currentVideoId, player.getVideoData().title || "유튜브 동영상");
        }

        function onPlayerStateChange(event) {
            updatePlayPauseIcon();

            // When Video Ends (YT.PlayerState.ENDED = 0)
            if (event.data === YT.PlayerState.ENDED) {
                if (isLoopEnabled) {
                    const startSec = isABLoopEnabled ? abStartTime : 0;
                    player.seekTo(startSec);
                    player.playVideo();
                }
            }
        }

        // --- Loop & A-B Control Loop Interval ---
        function startLoopChecker() {
            if (checkLoopInterval) clearInterval(checkLoopInterval);

            checkLoopInterval = setInterval(() => {
                if (!player || !isPlayerReady || typeof player.getCurrentTime !== 'function') return;

                const currentTime = player.getCurrentTime();
                const duration = player.getDuration();

                // Update Time UI
                document.getElementById('currentTimeDisplay').innerText = 
                    `${formatTime(currentTime)} / ${formatTime(duration)}`;

                // A-B Loop Logic
                if (isABLoopEnabled && abEndTime > abStartTime && abEndTime > 0) {
                    if (currentTime >= abEndTime || currentTime < abStartTime - 0.5) {
                        player.seekTo(abStartTime);
                        player.playVideo();
                    }
                }
            }, 250);
        }

        // --- Video Controls ---
        function togglePlayPause() {
            if (!player || !isPlayerReady) return;
            const state = player.getPlayerState();
            if (state === YT.PlayerState.PLAYING) {
                player.pauseVideo();
            } else {
                player.playVideo();
            }
        }

        function stopVideo() {
            if (!player || !isPlayerReady) return;
            player.stopVideo();
        }

        function restartVideo() {
            if (!player || !isPlayerReady) return;
            const start = isABLoopEnabled ? abStartTime : 0;
            player.seekTo(start);
            player.playVideo();
        }

        function toggleMute() {
            if (!player || !isPlayerReady) return;
            const muteIcon = document.getElementById('muteIcon');
            if (player.isMuted()) {
                player.unMute();
                muteIcon.className = "ph-bold ph-speaker-high text-xl";
            } else {
                player.mute();
                muteIcon.className = "ph-bold ph-speaker-slash text-xl text-rose-400";
            }
        }

        function toggleLoop() {
            isLoopEnabled = !isLoopEnabled;
            const btn = document.getElementById('loopToggleBtn');
            const text = document.getElementById('loopStatusText');

            if (isLoopEnabled) {
                btn.className = "px-3.5 h-11 rounded-xl bg-indigo-600/20 text-indigo-300 border border-indigo-500/40 hover:bg-indigo-600/30 font-medium text-xs flex items-center gap-2 transition-all";
                text.innerText = "무한반복 ON";
            } else {
                btn.className = "px-3.5 h-11 rounded-xl bg-slate-800 text-slate-400 border border-slate-700 hover:bg-slate-700 font-medium text-xs flex items-center gap-2 transition-all";
                text.innerText = "무한반복 OFF";
            }
        }

        function updatePlayPauseIcon() {
            if (!player || !isPlayerReady) return;
            const playIcon = document.getElementById('playIcon');
            const state = player.getPlayerState();

            if (state === YT.PlayerState.PLAYING) {
                playIcon.className = "ph-bold ph-pause text-xl";
            } else {
                playIcon.className = "ph-bold ph-play text-xl";
            }
        }

        function enableControls(enable) {
            document.getElementById('playPauseBtn').disabled = !enable;
            document.getElementById('stopBtn').disabled = !enable;
            document.getElementById('restartBtn').disabled = !enable;
            document.getElementById('muteBtn').disabled = !enable;
        }

        // --- A-B Repeat Functions ---
        function toggleABLoop() {
            isABLoopEnabled = document.getElementById('abLoopToggle').checked;
            validateAndSaveAB();
        }

        function setABCurrent(type) {
            if (!player || !isPlayerReady) return;
            const currentTime = Math.floor(player.getCurrentTime());
            const timeStr = formatTime(currentTime);

            if (type === 'start') {
                document.getElementById('startTime').value = timeStr;
            } else if (type === 'end') {
                document.getElementById('endTime').value = timeStr;
            }
            validateAndSaveAB();
        }

        function validateAndSaveAB() {
            const startVal = document.getElementById('startTime').value;
            const endVal = document.getElementById('endTime').value;

            abStartTime = parseTimeToSeconds(startVal);
            abEndTime = parseTimeToSeconds(endVal);

            if (isABLoopEnabled && abEndTime > 0 && abEndTime <= abStartTime) {
                alert('종료 시간(B)은 시작 시간(A)보다 커야 합니다.');
                document.getElementById('abLoopToggle').checked = false;
                isABLoopEnabled = false;
            }
        }

        // Utility: Format Time in HH:MM:SS or MM:SS
        function formatTime(seconds) {
            if (isNaN(seconds) || seconds < 0) return "00:00";
            const sec = Math.floor(seconds);
            const h = Math.floor(sec / 3600);
            const m = Math.floor((sec % 3600) / 60);
            const s = sec % 60;

            if (h > 0) {
                return `${h}:${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
            }
            return `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
        }

        // Utility: Parse MM:SS or SSS to Seconds
        function parseTimeToSeconds(input) {
            if (!input) return 0;
            const parts = input.toString().trim().split(':').map(Number);
            if (parts.some(isNaN)) return 0;

            if (parts.length === 1) return parts[0];
            if (parts.length === 2) return parts[0] * 60 + parts[1];
            if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
            return 0;
        }

        // --- URL Handling ---
        function extractVideoId(url) {
            if (!url) return null;
            url = url.trim();

            // Direct Video ID Check (11 chars)
            if (/^[a-zA-Z0-9_-]{11}$/.test(url)) return url;

            // YouTube URLs Regex
            const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            const match = url.match(regExp);

            return (match && match[2].length === 11) ? match[2] : null;
        }

        function handleUrlSubmit(e) {
            e.preventDefault();
            const inputEl = document.getElementById('youtubeUrl');
            const errorEl = document.getElementById('errorMessage');
            const videoId = extractVideoId(inputEl.value);

            if (videoId) {
                errorEl.classList.add('hidden');
                createPlayer(videoId);
            } else {
                errorEl.classList.remove('hidden');
            }
        }

        function clearInput() {
            document.getElementById('youtubeUrl').value = '';
            document.getElementById('clearBtn').classList.add('hidden');
        }

        // Show/Hide Clear Button in Input
        document.getElementById('youtubeUrl').addEventListener('input', function(e) {
            const clearBtn = document.getElementById('clearBtn');
            if (e.target.value.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }
        });

        // --- History Management (LocalStorage) ---
        function getHistory() {
            const data = localStorage.getItem('looptube_history');
            return data ? JSON.parse(data) : [];
        }

        function saveToHistory(videoId, title) {
            let history = getHistory();
            // Remove existing duplicate entry
            history = history.filter(item => item.id !== videoId);
            
            // Unshift new item
            history.unshift({
                id: videoId,
                title: title || `비디오 ID: ${videoId}`,
                timestamp: new Date().toLocaleDateString('ko-KR')
            });

            // Keep max 10 items
            if (history.length > 10) history = history.slice(0, 10);

            localStorage.setItem('looptube_history', JSON.stringify(history));
            loadHistoryUI();
        }

        function loadHistoryUI() {
            const historyList = document.getElementById('historyList');
            const history = getHistory();

            if (history.length === 0) {
                historyList.innerHTML = `
                    <div class="text-center py-8 text-xs text-slate-500">
                        최근 재생한 기록이 없습니다.
                    </div>
                `;
                return;
            }

            historyList.innerHTML = history.map(item => `
                <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900/60 border border-slate-800/80 hover:border-indigo-500/40 hover:bg-slate-800/50 transition-all group cursor-pointer" onclick="playFromHistory('${item.id}')">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <div class="w-12 h-8 rounded-lg overflow-hidden bg-slate-950 flex-shrink-0 relative">
                            <img src="https://img.youtube.com/vi/${item.id}/default.jpg" alt="thumbnail" class="w-full h-full object-cover">
                        </div>
                        <div class="flex flex-col overflow-hidden">
                            <span class="text-xs font-medium text-slate-200 truncate group-hover:text-indigo-300 transition-colors">${item.title}</span>
                            <span class="text-[10px] text-slate-500">${item.timestamp}</span>
                        </div>
                    </div>
                    <button onclick="event.stopPropagation(); removeFromHistory('${item.id}')" class="text-slate-500 hover:text-rose-400 p-1.5 transition-colors">
                        <i class="ph-bold ph-x text-sm"></i>
                    </button>
                </div>
            `).join('');
        }

        function playFromHistory(videoId) {
            document.getElementById('youtubeUrl').value = `https://www.youtube.com/watch?v=${videoId}`;
            document.getElementById('clearBtn').classList.remove('hidden');
            createPlayer(videoId);
        }

        function removeFromHistory(videoId) {
            let history = getHistory();
            history = history.filter(item => item.id !== videoId);
            localStorage.setItem('looptube_history', JSON.stringify(history));
            loadHistoryUI();
        }

        function clearHistory() {
            localStorage.removeItem('looptube_history');
            loadHistoryUI();
        }
    </script>
</body>
</html>
